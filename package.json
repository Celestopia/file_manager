{
  "name": "file-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-pdf.mjs && vite --port 1420 --strictPort",
    "build": "node scripts/prepare-pdf.mjs && tsc && vite build",
    "test": "vitest run",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "pretest": "node scripts/export-contract.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"*.{json,ts,mjs,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"*.{json,ts,mjs,md}\" \"docs/**/*.md\"",
    "check": "tsc --noEmit && npm run lint && npm run format:check && npm test && cargo test --locked && cargo fmt --all -- --check && cargo clippy --locked --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "dompurify": "^3.2.0",
    "marked": "^16.0.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.8",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
